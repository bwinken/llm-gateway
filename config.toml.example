# ==========================================
# LLM Gateway Configuration
# ==========================================

[app]
host = "0.0.0.0"
port = 8050
log_level = "info"

# ==========================================
# Pricing (USD per 1M tokens)
# ==========================================
[pricing]
# Fallback prices when no type-specific pricing is defined
default_input_price_per_1m = 0.10
default_output_price_per_1m = 0.10

[pricing.llm]
input_price_per_1m = 0.50
output_price_per_1m = 1.50

[pricing.vlm]
input_price_per_1m = 5.00
output_price_per_1m = 15.00

[pricing.embedding]
input_price_per_1m = 0.02
output_price_per_1m = 0.00

[pricing.vision_embedding]
input_price_per_1m = 1.00
output_price_per_1m = 0.00

[pricing.reranker]
input_price_per_1m = 0.05
output_price_per_1m = 0.00

[pricing.vision_reranker]
input_price_per_1m = 2.00
output_price_per_1m = 0.00


# ==========================================
# Fallback (optional)
# When a model's server is down, prefer this model as fallback for that type.
# If not set, falls back to the first alive model of the same type.
# ==========================================
[fallback]
# llm = "backup-llm"
# vlm = "backup-vlm"
# embedding = "backup-embedding"
# vision_embedding = "backup-vision-embedding"
# reranker = "backup-reranker"
# vision_reranker = "backup-vision-reranker"


# ==========================================
# Model Routing
# ==========================================

# ------------------------------------------
# LLM
# ------------------------------------------
[models.llm]
[models.llm."my-llm"]
real_model = "my-llm-model-name"
base_url = "http://your-llm-server:8000/v1"
api_key = "your-api-key"

# ------------------------------------------
# VLM (Vision Language Model)
# ------------------------------------------
[models.vlm]
[models.vlm."my-vlm"]
real_model = "my-vlm-model-name"
base_url = "http://your-vlm-server:8001/v1"
api_key = "your-api-key"

# ------------------------------------------
# Embedding
# ------------------------------------------
[models.embedding]
[models.embedding."bge-m3"]
real_model = "BAAI/bge-m3"
base_url = "http://your-embedding-server:8080/v1"
api_key = "your-api-key"

# ------------------------------------------
# Vision Embedding
# ------------------------------------------
[models.vision_embedding]
[models.vision_embedding."qwen3-vl-embedding"]
real_model = "Qwen/Qwen3-VL-Embedding-2B"
base_url = "http://your-vision-embedding-server:8090/v1"
api_key = "your-api-key"

# ------------------------------------------
# Reranker
# ------------------------------------------
[models.reranker]
[models.reranker."bge-reranker-v2-m3"]
real_model = "BAAI/bge-reranker-v2-m3"
base_url = "http://your-reranker-server:8080/v1"
api_key = "your-api-key"

# ------------------------------------------
# Vision Reranker
# ------------------------------------------
[models.vision_reranker]
[models.vision_reranker."qwen3-vl-reranker"]
real_model = "Qwen/Qwen3-VL-Reranker-2B"
base_url = "http://your-vision-reranker-server:8091/v1"
api_key = "your-api-key"
