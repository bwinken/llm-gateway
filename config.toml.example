# ==========================================
# LLM Gateway Configuration
# ==========================================

[app]
host = "0.0.0.0"
port = 8050
log_level = "info"

# ==========================================
# Pricing (USD per 1M tokens)
# ==========================================
[pricing]
# Fallback prices when no type-specific pricing is defined
default_input_price_per_1m = 0.10
default_output_price_per_1m = 0.10

[pricing.llm]
input_price_per_1m = 0.50
output_price_per_1m = 1.50

[pricing.vlm]
input_price_per_1m = 5.00
output_price_per_1m = 15.00

[pricing.embedding]
input_price_per_1m = 0.02
output_price_per_1m = 0.00

[pricing.vision_embedding]
input_price_per_1m = 1.00
output_price_per_1m = 0.00

[pricing.reranker]
input_price_per_1m = 0.05
output_price_per_1m = 0.00

[pricing.vision_reranker]
input_price_per_1m = 2.00
output_price_per_1m = 0.00


# ==========================================
# Fallback (optional)
# When a model's server is down, prefer this model as fallback for that type.
# If not set, falls back to the first alive model of the same type.
# ==========================================
[fallback]
# llm = "backup-llm"
# vlm = "backup-vlm"
# embedding = "backup-embedding"
# vision_embedding = "backup-vision-embedding"
# reranker = "backup-reranker"
# vision_reranker = "backup-vision-reranker"


# ==========================================
# Model Routing
# ==========================================

# ------------------------------------------
# LLM
# ------------------------------------------
# All metadata fields (display_name, context_window, max_output_tokens,
# supports_tools/vision/prompt_caching, is_reasoning) are OPTIONAL. They're surfaced
# via GET /v1/models so clients that query for capabilities (Cursor,
# Cline, Continue.dev, future Claude Code versions, ...) get accurate
# info. Omitting them is fine — the fields just won't appear in the
# /v1/models response for that alias.
[models.llm]
[models.llm."my-llm"]
real_model = "my-llm-model-name"
base_url = "http://your-llm-server:8000/v1"
api_key = "your-api-key"
# Optional metadata:
# display_name = "My LLM 72B"
# context_window = 65536
# max_output_tokens = 8192
# supports_tools = true
# supports_vision = false
# supports_prompt_caching = false
# is_reasoning = false    # Set true for thinking / chain-of-thought models (o1/QwQ/DeepSeek-R1 etc.)
# hidden = false          # Hide from user-facing pages and /v1/models (still usable via API)

# ------------------------------------------
# VLM (Vision Language Model)
# ------------------------------------------
[models.vlm]
[models.vlm."my-vlm"]
real_model = "my-vlm-model-name"
base_url = "http://your-vlm-server:8001/v1"
api_key = "your-api-key"
# display_name = "My VLM 32B"
# context_window = 32768
# max_output_tokens = 4096
# supports_tools = true
# supports_vision = true

# ------------------------------------------
# Embedding
# ------------------------------------------
[models.embedding]
[models.embedding."bge-m3"]
real_model = "BAAI/bge-m3"
base_url = "http://your-embedding-server:8080/v1"
api_key = "your-api-key"

# ------------------------------------------
# Vision Embedding
# ------------------------------------------
[models.vision_embedding]
[models.vision_embedding."qwen3-vl-embedding"]
real_model = "Qwen/Qwen3-VL-Embedding-2B"
base_url = "http://your-vision-embedding-server:8090/v1"
api_key = "your-api-key"

# ------------------------------------------
# Reranker
# ------------------------------------------
[models.reranker]
[models.reranker."bge-reranker-v2-m3"]
real_model = "BAAI/bge-reranker-v2-m3"
base_url = "http://your-reranker-server:8080/v1"
api_key = "your-api-key"

# ------------------------------------------
# Vision Reranker
# ------------------------------------------
[models.vision_reranker]
[models.vision_reranker."qwen3-vl-reranker"]
real_model = "Qwen/Qwen3-VL-Reranker-2B"
base_url = "http://your-vision-reranker-server:8091/v1"
api_key = "your-api-key"


# ==========================================
# Azure fallback (optional)
# ==========================================
# When a client posts to /azure/v1/* with an alias that isn't in
# [azure_models.*] (typo, model rename, client probing for a name we don't
# offer), the gateway falls back to the alias listed here for the matching
# type instead of returning 400. If no [azure_fallback] entry covers the
# requested type, it auto-picks the first compatible [azure_models.*].
# Responses include `X-Model-Fallback: <reason>` so clients can detect it.
#
# There is intentionally no runtime error-driven fallback (429/5xx) — Azure
# is a managed service and per-request fallback during a stream isn't safe.
[azure_fallback]
# llm = "gpt-4o"
# vlm = "gpt-4o"


# ==========================================
# Azure OpenAI Models (served at /azure/v1/*)
# ==========================================
# The gateway sends every Azure LLM/VLM call to the v1 Responses API
# (/openai/v1/responses), so:
#  - `endpoint` is the bare resource host. A trailing `/openai` is
#    stripped automatically.
#  - `deployment` is the Azure portal deployment name. The gateway sets
#    body.model to this on each request.
#  - `api_version` is accepted for backward compatibility but currently
#    unused; the v1 Responses surface does not take an api-version query.
#  - Routed by deployment name (no health-check). Type-aware fallback for
#    unknown aliases is configured via [azure_fallback] above. Same
#    metadata and per-model pricing override fields as [models.*] are
#    accepted.
#  - Responses API does not cover embeddings; `/azure/v1/embeddings` is
#    intentionally not exposed. Configure embeddings on a vLLM backend.
# [azure_models."gpt-4o"]
# type = "llm"
# endpoint = "https://my-resource.cognitiveservices.azure.com"
# deployment = "gpt-4o"
# api_key = "your-azure-api-key"
# display_name = "GPT-4o"
# context_window = 128000
# max_output_tokens = 16384
# supports_tools = true
# supports_vision = true
# input_price_per_1m = 2.50
# output_price_per_1m = 10.00
