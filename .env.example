# LLM Gateway Environment Variables
APP_TITLE=LLM Gateway
DATABASE_URL=postgresql://llm_gateway:your_password@localhost:5432/llm_gateway

# AuthCenter JWT validation (oauth2-proxy handles login flow)
AUTH_CENTER_APP_ID=llm_gateway
AUTH_CENTER_PUBLIC_KEY_PATH=./keys/public.pem
AUTH_BASE_URL=http://auth.company.com

# Application log file settings (optional)
# One file per worker PID under LOG_DIR to avoid multi-worker write races.
# Rotation/retention are passed through to loguru.
# LOG_DIR=./logs
# LOG_LEVEL=WARNING
# LOG_ROTATION=100 MB
# LOG_RETENTION=14 days

# Log downstream request bodies verbatim on a 4xx/5xx (optional, default off)
# Off, an Azure/Bedrock error logs the SHAPE of the request — fields, roles,
# content-block types, string lengths — which is what actually diagnoses a
# 400. On, it logs the raw body, i.e. the user's prompt (source code, pasted
# data) in plain text under LOG_DIR for LOG_RETENTION. Turn it on to chase a
# specific bug, then turn it back off.
# LOG_REQUEST_BODIES=false

# Failed API-key auth throttle (optional). An address that sends this many
# DIFFERENT invalid keys within the window is refused (429) for the lockout,
# valid key or not. Repeating one wrong key never counts more than once, so a
# stale client behind a shared NAT does not lock out its colleagues. Per
# worker, in memory. Loopback is never locked. 0 turns it off.
# AUTH_FAIL_DISTINCT_KEYS=10
# AUTH_FAIL_WINDOW_S=600
# AUTH_LOCKOUT_S=900

# Daily spending limit enforcement (optional, defaults to "true")
# Set to "false" to disable 429 blocking globally — overages are still
# logged at WARNING level but requests go through. There is no per-user
# "unlimited": a user's daily_limit_usd of 0 is a $0 budget.
# ENFORCE_DAILY_LIMIT=true

# Warn in the log about requests slower than this many seconds (optional).
# 0 turns the warning off.
# SLOW_REQUEST_WARN_S=120

# The web UI's Setup page (/setup) and the Claude Code installer behind it
# are for Windows users (the installer is a .bat). Set to "false" where your
# users work on Linux: the page and the download answer 404 and every link
# to them is left off. The admin's Install Guide URL (Admin -> Settings ->
# Site Links) is then linked in the top bar instead.
# SETUP_PAGE_ENABLED=true

# Connection pool of the on-prem (vLLM) client (optional). Each open stream
# holds one connection, so the first number bounds concurrent streams.
# DOWNSTREAM_MAX_CONNECTIONS=1000
# DOWNSTREAM_MAX_KEEPALIVE_CONNECTIONS=100

# Corporate HTTP proxy for Azure OpenAI traffic (optional).
# Only /azure/v1/* downstream calls go through this proxy — internal
# vLLM downstreams are never proxied. Leave unset to reach Azure directly.
# Inline credentials are supported: http://user:pass@proxy.company.local:8080
# AZURE_HTTP_PROXY=http://proxy.company.local:8080

# Disable TLS verification for Azure OpenAI downstream calls (optional).
# Set to "true" when a corporate TLS-inspecting proxy re-signs Azure's cert
# with a CA that isn't in the system trust store. Equivalent to curl --insecure.
# Affects only the Azure-bound httpx client; vLLM traffic is unchanged.
# AZURE_INSECURE=false

# HTTP proxy for AWS Bedrock downstream calls (optional). Same contract as
# AZURE_HTTP_PROXY: only /aws/v1/* downstream traffic goes through it;
# vLLM traffic is never proxied. Supports inline credentials.
# BEDROCK_HTTP_PROXY=http://user:pass@proxy.corp.example.com:8080

# Disable TLS verification for Bedrock downstream calls (optional).
# Same contract as AZURE_INSECURE; affects only the Bedrock-bound client.
# BEDROCK_INSECURE=false

# Connection pools of the Azure and Bedrock clients (optional). Idle
# connections are kept for CLOUD_KEEPALIVE_EXPIRY_S so the next turn of a
# conversation reuses the TLS session instead of a new WAN handshake.
# CLOUD_KEEPALIVE_EXPIRY_S=30
# CLOUD_MAX_CONNECTIONS=200
# CLOUD_MAX_KEEPALIVE_CONNECTIONS=100

# AWS Bedrock settings shared by every [bedrock_models.*] entry (optional).
# Set them once here instead of on each model; a model's own `region`,
# `api_key` or IAM pair in config.toml wins. With the IAM pair, every request
# is SigV4-signed and the secret is never sent. Kept out of config.toml, so
# the admin Model Config page never loads the secret. Restart after changes.
# BEDROCK_REGION=ap-northeast-1
# BEDROCK_AWS_ACCESS_KEY_ID=AKIA...
# BEDROCK_AWS_SECRET_ACCESS_KEY=...

# Langfuse observability (optional). The gateway emits one Langfuse generation
# per billable request (cost / usage / model / user / client software / scores)
# when ALL THREE of HOST + PUBLIC_KEY + SECRET_KEY are set. Leave any unset to
# disable entirely (no-op, zero overhead). Self-hosted recommended.
# The SDK reads these variable names natively.
# LANGFUSE_HOST=http://langfuse.internal:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
#
# Fraction of billable requests to record in Langfuse, 0.0 to 1.0 (optional).
# Default 1.0 records everything; e.g. 0.1 records ~10% of requests, 0.0
# records nothing. Out-of-range values are clamped; invalid values fall back
# to 1.0 with a warning. Only affects Langfuse — usage_logs billing always
# records every request.
# LANGFUSE_SAMPLE_RATE=1.0
#
# Also capture full prompt/response CONTENT (PII-sensitive): chat / messages /
# responses on every backend, plus /v1/systemone. Capturing individual users'
# prompts is individual-level monitoring — restrict Langfuse project access and
# confirm notice/consent before enabling in production
# (see docs/langfuse-observability.md).
# LANGFUSE_CAPTURE_IO=false

# ── Prometheus metrics (optional) ──
# Set to true to serve GET /metrics (gateway request counts, tokens, spend,
# latency/TTFT histograms, 429 rejections, in-flight requests, on-prem server
# health). Off by default: the endpoint answers 404. Works with --workers N
# (values are summed across workers through files under METRICS_DIR, default
# <tmp>/llm-gateway-metrics). Scrape http://127.0.0.1:8050/metrics on the host;
# the example nginx config does not expose it.
# METRICS_ENABLED=true
# METRICS_DIR=/var/tmp/llm-gateway-metrics

# ── Daily usage rollup ──
# Every worker rolls closed Asia/Taipei days of usage_logs into usage_daily in
# the background (reports read it instead of re-scanning a month of requests).
# Seconds between checks; 0 turns it off (reports then read usage_logs: same
# numbers, slower as days pile up). No cron/systemd timer needed.
# USAGE_ROLLUP_INTERVAL_S=600

# ── Periodic jobs (run inside the gateway; no systemd timer or cron) ──
# Each runs once per interval across all workers/hosts (claimed in the
# scheduled_jobs table). 0 turns a job off.
# Hourly usage-anomaly scan (detection only, never blocks anyone):
# ANOMALY_SCAN_INTERVAL_S=3600
# usage_logs retention: delete raw rows older than N days, daily. OFF unless
# set: usage_logs is the billing/audit record, deleting it is a governance
# decision. Only days already rolled into usage_daily are deleted, so
# reports keep them.
# USAGE_LOG_RETENTION_DAYS=365


# ── Mail (Exchange EWS + NTLM, the same method as AuthCenter; optional) ──
# Used by the admin panel's Client rules to mail the accounts a rule matches.
# On only when all five are set. An account's mailbox is
# <username>@<COMPANY_EMAIL_DOMAIN>. Use a dedicated service account; if the
# gateway runs with HTTPS_PROXY, add the Exchange host to NO_PROXY.
# COMPANY_EMAIL_DOMAIN=company.com
# EXCHANGE_SERVER=mail.company.com
# EXCHANGE_USER='DOMAIN\username'
# EXCHANGE_PASSWORD='your_exchange_password'
# EXCHANGE_EMAIL=noreply@company.com
# Where browsers reach the gateway, for the dashboard link in mail and in
# the in-terminal reminder:
# PUBLIC_BASE_URL=https://llm-gateway.company.com
# Client-rule mail is never sent as one burst (a mail server may treat a
# burst as abuse). Each run of the mail job sends at most BATCH mails, PAUSE
# seconds apart, and runs every INTERVAL seconds; whatever is left waits for
# the next run. A click on a mail button in the admin panel is paced the same
# way. Defaults: 20 mails every 10 minutes, 2 s apart (120 an hour).
# INTERVAL=0 turns the job off (and with it the monthly reminder that an admin
# can switch on in the admin panel: it is sent by the same job).
# CLIENT_RULE_MAIL_BATCH=20
# CLIENT_RULE_MAIL_PAUSE_S=2
# CLIENT_RULE_MAIL_INTERVAL_S=600
# The weekly report mails (Admin -> Settings -> Weekly reports) are looked at
# this often, so a report goes out within that many seconds of its time.
# 0 turns them off. Their days, times and recipients are set on that card.
# WEEKLY_REPORT_TICK_S=300
