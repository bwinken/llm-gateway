# LLM Gateway Environment Variables
APP_TITLE=LLM Gateway
DATABASE_URL=postgresql://llm_gateway:your_password@localhost:5432/llm_gateway

# AuthCenter OAuth2 SSO
AUTH_CENTER_BASE_URL=http://localhost:8000
AUTH_CENTER_APP_ID=llm_gateway
AUTH_CENTER_CLIENT_SECRET=change-me
AUTH_CENTER_REDIRECT_URI=http://localhost:8050/auth/callback
AUTH_CENTER_PUBLIC_KEY_PATH=./keys/public.pem

