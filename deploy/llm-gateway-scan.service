[Unit]
Description=LLM Gateway anomaly scan (hourly, detection only)

[Service]
Type=oneshot
WorkingDirectory=%h/opt/llm-gateway
Environment=PYTHONUTF8=1
Environment="PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/uv run python scripts/scan_anomalies.py --execute
