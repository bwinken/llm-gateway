# deploy/.env.example — docker compose 環境變數
# 複製為 .env 後填入實際值: cp deploy/.env.example deploy/.env

# ─── PostgreSQL ───
PG_USER=llm_gateway
PG_PASSWORD=your_password
PG_DB=llm_gateway
PG_PORT=5432
# 使用絕對路徑避免相對路徑歧義，setup.sh 會自動設定
PGDATA_DIR=./pgdata

# ─── OAuth2 Proxy / OIDC ───
OIDC_ISSUER_URL=http://auth.company.com
OAUTH2_CLIENT_ID=llm_gateway
OAUTH2_CLIENT_SECRET=change-me
OAUTH2_REDIRECT_URL=http://llm-gateway.your-domain.com/oauth2/callback
OAUTH2_COOKIE_NAME=_llm_gw_oauth2
# 產生方式: openssl rand -base64 32 | head -c 32
OAUTH2_COOKIE_SECRET=

# ─── Gateway 容器（只在 --profile gateway 時使用；systemd 部署可忽略）───
# 映像：docker compose build 產生，或從其他機器 docker load 進來的名稱
GATEWAY_IMAGE=llm-gateway:latest
# 容器以這個使用者執行；要和 config/、logs/ 目錄的擁有者相同（id -u / id -g）
GATEWAY_UID=1000
GATEWAY_GID=1000
GATEWAY_PORT=8050
GATEWAY_WORKERS=2
