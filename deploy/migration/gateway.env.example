# Gateway 容器的設定：加到「以容器執行 gateway 的主機」的 deploy/.env 裡。
# （deploy/.env.example 沒有這些；systemd 部署用不到。）

# 映像：compose.sh build 產生，或從其他機器 docker load 進來的名稱
GATEWAY_IMAGE=llm-gateway:latest
# 容器以這個使用者執行；要和 config/、logs/ 目錄的擁有者相同（id -u / id -g）
GATEWAY_UID=1000
GATEWAY_GID=1000
GATEWAY_PORT=8050
GATEWAY_WORKERS=2
