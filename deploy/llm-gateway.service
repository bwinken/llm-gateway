[Unit]
Description=LLM Gateway FastAPI Application
After=network.target

[Service]
Type=exec
WorkingDirectory=%h/opt/llm-gateway
EnvironmentFile=%h/opt/llm-gateway/.env
Environment=PYTHONUTF8=1
Environment="PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
# 如需透過 Proxy 連外網，取消下方註解
# Environment="HTTP_PROXY=http://proxy.company.com:8080"
# Environment="HTTPS_PROXY=http://proxy.company.com:8080"
# Environment="NO_PROXY=localhost,127.0.0.1"
ExecStart=%h/.local/bin/uv run fastapi run app/main.py \
    --host 127.0.0.1 \
    --port 8050 \
    --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
