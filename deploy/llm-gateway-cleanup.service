[Unit]
Description=LLM Gateway usage_logs retention cleanup (monthly)

[Service]
Type=oneshot
WorkingDirectory=%h/opt/llm-gateway
Environment=PYTHONUTF8=1
Environment="PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/uv run python scripts/cleanup_usage_logs.py --execute
