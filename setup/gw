#!/bin/sh
# gw - your LLM Gateway budget, models and usage, in the terminal.
#
#   gw              today's budget, then the models and whether they are up
#   gw me           today's budget
#   gw models       the models you can use: up or down, load, price
#   gw usage [N]    the last N days (default 7) and this month by model
#   gw update       replace this script with the gateway's current one
#   gw help
#
#   --json          the JSON instead of the text view (me, models, usage)
#   --color         colours even when not writing to a terminal (watch --color)
#   --no-color      no colours (NO_COLOR is honoured too)
#   --ascii         no block characters (automatic outside a UTF-8 locale)
#
# The key is never stored here. gw uses, in this order:
#   LLM_GATEWAY_API_KEY
#   ANTHROPIC_AUTH_TOKEN from the environment, then from the "env" block of
#   Claude Code's settings.json - but only while ANTHROPIC_BASE_URL there
#   points at this gateway, so a token meant for another service is never
#   sent here.
# The gateway's address is LLM_GATEWAY_URL, else the one this script was
# downloaded from, else Claude Code's ANTHROPIC_BASE_URL.
#
# Needs curl. Reading settings.json uses python3 or jq when there is one.

set -eu

GATEWAY_URL='__GATEWAY_URL__'   # filled in when downloaded from GET /v1/cli
case $GATEWAY_URL in __*) GATEWAY_URL= ;; esac

NL='
'

die() {
    printf 'gw: %s\n' "$*" >&2
    exit 1
}

# scheme://host[:port] of a URL, lower case; nothing when it is not one.
origin() {
    printf '%s\n' "$1" | sed -n 's#^\([A-Za-z][A-Za-z]*://[^/?\#]*\).*#\1#p' | tr 'A-Z' 'a-z'
}

# Value of env.<name> in Claude Code's settings.json; nothing when absent.
settings_env() {
    file=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
    [ -r "$file" ] || return 0
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        value = json.load(handle).get("env", {}).get(sys.argv[2], "")
except Exception:
    value = ""
print(value if isinstance(value, str) else "")' "$file" "$1"
    elif command -v jq >/dev/null 2>&1; then
        jq -r --arg name "$1" '.env[$name] // empty' "$file" 2>/dev/null || true
    else
        sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | head -n 1
    fi
}

# Sets $url and $key, or stops with what is missing.
find_gateway() {
    url=$(origin "${LLM_GATEWAY_URL:-$GATEWAY_URL}")
    key=${LLM_GATEWAY_API_KEY:-}
    for source in environment settings; do
        if [ -n "$url" ] && [ -n "$key" ]; then
            break
        fi
        if [ "$source" = environment ]; then
            token=${ANTHROPIC_AUTH_TOKEN:-}
            base=$(origin "${ANTHROPIC_BASE_URL:-}")
        else
            token=$(settings_env ANTHROPIC_AUTH_TOKEN)
            base=$(origin "$(settings_env ANTHROPIC_BASE_URL)")
        fi
        # No base URL: that Claude Code talks to Anthropic, not to a gateway.
        [ -n "$base" ] || continue
        # Another address than ours: its token is for something else.
        if [ -n "$url" ] && [ "$url" != "$base" ]; then
            continue
        fi
        # No token there and none yet: nothing to take from this one.
        if [ -z "$key" ] && [ -z "$token" ]; then
            continue
        fi
        url=$base
        [ -n "$key" ] || key=$token
    done
    [ -n "$url" ] || die "no gateway address. Set LLM_GATEWAY_URL (https://your-gateway)."
    [ -n "$key" ] || die "no API key for $url. Set LLM_GATEWAY_API_KEY, or put your key in Claude Code's settings (the dashboard's My API Key window has a script for that)."
    case $key in
        *[!A-Za-z0-9._~+/=-]*) die "the API key holds a character no key has; check it." ;;
    esac
}

# GET $1 (path and query) and print the body. The key goes to curl on its
# standard input, never on the command line, where `ps` would show it to
# everyone else on the machine.
fetch() {
    reply=$(printf 'header = "Authorization: Bearer %s"\n' "$key" |
        curl -sS -K - --max-time "${GW_TIMEOUT:-20}" -w '\n%{http_code}' "$url$1") ||
        die "could not reach $url"
    status=${reply##*"$NL"}
    body=${reply%"$NL"*}
    body=${body%"$NL"}
    case $status in
        200) ;;
        401) die "$url refused the key (401). If you regenerated it, update it on this machine too. $body" ;;
        *) die "$url answered $status. $body" ;;
    esac
    printf '%s\n' "$body"
}

# Print one view: $1 = path, $2 = its own query (may be empty).
show() {
    query=$2
    if [ "$json" = 0 ]; then
        query="${query:+$query&}format=text"
        [ "$color" = 0 ] || query="$query&color=1"
        [ "$ascii" = 0 ] || query="$query&ascii=1"
    fi
    fetch "$1${query:+?$query}"
}

update() {
    self=$0
    case $self in
        */*) ;;
        *) self=$(command -v -- "$self") || die "cannot find where gw is installed" ;;
    esac
    [ -w "$self" ] || die "cannot write $self"
    new=$(fetch /v1/cli)
    case $new in
        '#!/bin/sh'*) ;;
        *) die "$url did not send a script" ;;
    esac
    printf '%s\n' "$new" >"$self.new.$$"
    chmod +x "$self.new.$$"
    mv "$self.new.$$" "$self"
    printf 'gw: updated %s\n' "$self"
}

color=auto
ascii=auto
json=0
command=
argument=
for word in "$@"; do
    case $word in
        --json) json=1 ;;
        --color) color=1 ;;
        --no-color) color=0 ;;
        --ascii) ascii=1 ;;
        -h | --help) command=help ;;
        -*) die "unknown option $word (try: gw help)" ;;
        *)
            if [ -z "$command" ]; then
                command=$word
            elif [ -z "$argument" ]; then
                argument=$word
            else
                die "too many arguments (try: gw help)"
            fi
            ;;
    esac
done

if [ "$color" = auto ]; then
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
        color=1
    else
        color=0
    fi
fi
if [ "$ascii" = auto ]; then
    case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
        *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) ascii=0 ;;
        *) ascii=1 ;;
    esac
fi

case $command in
    help)
        sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    '')
        find_gateway
        show /v1/me ''
        if [ "$json" = 0 ]; then
            printf '\n'
            show /v1/status ''
        fi
        ;;
    me | budget)
        find_gateway
        show /v1/me ''
        ;;
    models | status)
        find_gateway
        show /v1/status ''
        ;;
    usage)
        case ${argument:-7} in
            *[!0-9]* | '') die "usage: gw usage [DAYS]" ;;
        esac
        find_gateway
        show /v1/usage "days=${argument:-7}"
        ;;
    update)
        find_gateway
        update
        ;;
    *)
        die "unknown command $command (try: gw help)"
        ;;
esac
